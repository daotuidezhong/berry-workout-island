{
  "name": "berry-workout-island",
  "version": "0.9.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop:build": "npm run desktop:build:win",
    "desktop:build:win": "vite build --config desktop/vite.config.ts && electron-builder --win nsis",
    "desktop:build:mac": "vite build --config desktop/vite.config.ts && electron-builder --mac dmg"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "electron-updater": "6.8.9",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.berryworkout.island",
    "productName": "OH",
    "directories": {
      "output": "outputs"
    },
    "files": [
      "electron/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-dist",
        "to": "desktop-dist"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Berry-Workout-Island-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.lifestyle",
      "artifactName": "OH-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OH"
    },
    "publish": {
      "provider": "github",
      "owner": "daotuidezhong",
      "repo": "berry-workout-island"
    }
  }
}
